# ── Step 1: Compile CSS ────────────────────────────────────────────────────────
puts "[1/5] Compiling CSS..."
FileUtils.mkdir_p(File.join(OUTPUT, 'assets'))

if SASS_BIN
  %w[styles programs].each do |name|
    src = File.join(ASSETS, "stylesheets/#{name}.scss")
    dst = File.join(OUTPUT, "assets/#{name}.css")
    system("ruby #{SASS_BIN} #{src} #{dst}")
  end
  puts "      SCSS compiled via #{SASS_BIN}"
else
  puts "      WARNING: sass not found. CSS not generated."
end
# strip.png is referenced by styles.css via url("strip.png")
FileUtils.cp(File.join(ASSETS, 'images/strip.png'), File.join(OUTPUT, 'assets/strip.png'))

# ── Step 2: Copy static assets ────────────────────────────────────────────────
puts "[2/5] Copying assets..."
FileUtils.cp_r(File.join(ASSETS, 'images/.'), File.join(OUTPUT, 'images'))
FileUtils.cp_r(File.join(PUBLIC, 'files'),     File.join(OUTPUT, 'files'))
FileUtils.cp_r(File.join(PUBLIC, 'showcases'), File.join(OUTPUT, 'showcases'))
FileUtils.cp(File.join(PUBLIC, 'favicon.ico'), File.join(OUTPUT, 'favicon.ico')) rescue nil
# PDFs stored in app/data/pdf/
pdf_src = File.join(DATA, 'pdf')
if File.directory?(pdf_src)
  FileUtils.mkdir_p(File.join(OUTPUT, 'files/pdf'))
  FileUtils.cp_r("#{pdf_src}/.", File.join(OUTPUT, 'files/pdf'))
end

# ── Step 3: Render main pages ─────────────────────────────────────────────────
puts "[3/5] Rendering pages..."

# Home
build_page('index.html',
  view_dir: 'single_page', template: 'home',
  title: 'Welcome to IEEE Pacific Visualization 2017!',
  banner_image: 'hoam_main.jpg', banner_size: :tall,
  vars: {
    general_chairs: CHAIR_GROUPS.find { |g| g.name == 'General Conference Co-Chairs' }&.chairs || []
  })

# Programs
build_page('programs/index.html',
  view_dir: 'programs', template: 'index',
  title: 'Programs',
  vars: {
    papers: PAPERS, posters: POSTERS, notes: NOTES, contests: CONTESTS,
    session_dict: SESSION_DICT,
    session_ordered_names: SESSION_ORDERED,
    session_rows: SESSION_ROWS,
    keynotes: KEYNOTES,
    workshops: WORKSHOPS
  })

# Awards
build_page('awards/index.html',
  view_dir: 'programs', template: 'awards',
  title: 'Award Winners for PacificVis 2017',
  vars: {
    awards: {
      papers: {
        best:      PAPERS.select { |p| p[:id] == 'papers_1490' },
        honorable: [2379, 1685, 2984].map { |n| PAPERS.find { |p| p[:id] == "papers_#{n}" } }.compact
      },
      notes: {
        best:      NOTES.select { |p| p[:id] == 'notes-112' },
        honorable: []
      },
      posters: {
        best:      POSTERS.select { |p| p[:id] == 'posters-120' },
        honorable: POSTERS.select { |p| p[:id] == 'posters-121' }
      },
      contest: {
        best:      CONTESTS.select { |p| p[:id] == 'contest-108' },
        honorable: CONTESTS.select { |p| p[:id] == 'contest-106' }
      }
    }
  })

# CFP
build_page('cfp/index.html',
  view_dir: 'call_for_participation', template: 'index',
  title: 'Call for Participation',
  vars: {
    deadlines: {
      papers:  get_deadlines('papers'),
      notes:   get_deadlines('notes'),
      contest: get_deadlines('contest'),
      posters: get_deadlines('posters')
    }
  })

build_page('cfp/paper/index.html',
  view_dir: 'call_for_participation', template: 'paper',
  title: 'Call for Papers',
  vars: {
    topics: TOPICS.keys.map { |k| { category: k, list: TOPICS[k] } },
    deadlines: get_deadlines('papers'),
    formatting_guideline: 'http://junctionpublishing.org/vgtc/Track/pacvis.html'
  })

build_page('cfp/visualization_notes/index.html',
  view_dir: 'call_for_participation', template: 'visualization_notes',
  title: 'Call for Visualization Notes',
  vars: {
    deadlines: get_deadlines('notes'),
    note_committee: NOTE_PC,
    formatting_guideline: 'http://junctionpublishing.org/vgtc/Track/pacvis.html'
  })

build_page('cfp/posters/index.html',
  view_dir: 'call_for_participation', template: 'posters',
  title: 'Call for Posters',
  vars: { deadlines: get_deadlines('posters') })

build_page('cfp/contest/index.html',
  view_dir: 'call_for_participation', template: 'contest',
  title: 'Call for Visual Storytelling Contest',
  vars: { deadlines: get_deadlines('contest') })

# Committee
build_page('committee/index.html',
  view_dir: 'single_page', template: 'committee',
  title: 'Conference Organizers',
  vars: { chair_groups: CHAIR_GROUPS,
          program_committee: PAPER_PC,
          note_committee: NOTE_PC })

# Venue
build_page('venue/index.html',
  view_dir: 'single_page', template: 'venue',
  title: 'PacificVis 2017 @ Seoul National University',
  vars: { routes_hoam: ROUTES_HOAM, accomodations: ACCOMMODATIONS })

# Registration
build_page('registration/index.html',
  view_dir: 'single_page', template: 'registration',
  title: 'Registration',
  vars: { fees: FEES })

# Keynotes
KEYNOTES.each do |k|
  build_page("keynotes/#{k[:day]}/index.html",
    view_dir: 'single_page', template: 'keynote',
    title: "[Keynote] #{k[:title].gsub(/<[^>]*>/, '')}",
    vars: { keynote: k })
end

# Workshops
WORKSHOPS.each_value do |talks|
  talks.each do |w|
    build_page("workshops/#{w['id']}/index.html",
      view_dir: 'single_page', template: 'workshop',
      title: w['title'],
      vars: { workshop: w })
  end
end

# ── Step 4: Render individual program pages ────────────────────────────────────
puts "[4/5] Rendering #{ALL_PROGRAMS.size} program pages..."
ALL_PROGRAMS.each do |prog|
  build_page("programs/#{prog[:id]}/index.html",
    view_dir: 'programs', template: 'program',
    title: prog[:title],
    vars: { program: prog })
end

# ── Step 5: Finalize ──────────────────────────────────────────────────────────
puts "[5/5] Finalizing..."
File.write(File.join(OUTPUT, '.nojekyll'), '')

html_count = Dir.glob(File.join(OUTPUT, '**/*.html')).size
puts "\nDone! #{html_count} HTML pages in #{OUTPUT}"
puts "Next: push to GitHub and enable Pages → /docs folder."
