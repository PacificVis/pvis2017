# ── Template rendering context ─────────────────────────────────────────────────
class Context
  attr_accessor :_erbout, :_view_dir

  def initialize(vars = {})
    @_erbout   = ''
    @_locals   = {}
    @_view_dir = nil
    vars.each { |k, v| instance_variable_set("@#{k}", v) }
    # Sidebar variables available on all pages
    @show_common_content = true
    @upcoming_deadlines  = UPCOMING
    @sponsors            = SPONSORS
    @previous            = PREVIOUS
    @channels            = CHANNELS
  end

  # ── ERB rendering ────────────────────────────────────────────────────────
  def _render_template(file)
    src = File.read(file, encoding: 'UTF-8')
    # Rails templates use `<%= helper ... do %>` which is syntactically invalid
    # in standard ERB (can't have `do` inside the << argument). Convert to `<% %>`.
    # The helpers (content_tag, link_to) will concat their result to @_erbout directly.
    src = src.gsub(/<%=\s*((?:content_tag|link_to)\b[^%]*?\bdo)\s*%>/, '<% \1 %>')
    ERB.new(src, nil, '-', '@_erbout').result(binding)
    @_erbout
  end

  def render(opts = {})
    name   = (opts[:partial] || opts['partial']).to_s
    locals = (opts[:locals] || opts['locals'] || {}).transform_keys(&:to_sym)

    parts = name.split('/')
    if parts.length >= 2
      dir   = parts[0..-2].join('/')
      fname = "_#{parts.last}.html.erb"
      file  = File.join(VIEWS, dir, fname)
    else
      fname = "_#{name}.html.erb"
      cur   = @_view_dir ? File.join(VIEWS, @_view_dir, fname) : nil
      file  = [cur,
               File.join(VIEWS, 'application', fname),
               File.join(VIEWS, 'programs', fname)
               ].compact.find { |f| File.exist?(f) }
    end
    raise "Partial not found: #{name}" unless file && File.exist?(file)

    saved_out  = @_erbout
    saved_dir  = @_view_dir
    saved_loc  = @_locals

    @_erbout   = ''
    @_view_dir = File.dirname(file).delete_prefix("#{VIEWS}/")
    @_locals   = locals

    _render_template(file)

    result     = @_erbout
    @_erbout   = saved_out
    @_view_dir = saved_dir
    @_locals   = saved_loc

    result
  end

  # Fall through to @_locals for partial local variables
  def method_missing(name, *args, &block)
    @_locals.key?(name.to_sym) ? @_locals[name.to_sym] : super
  end

  def respond_to_missing?(name, include_private = false)
    @_locals.key?(name.to_sym) || super
  end

  # ── HTML helpers ─────────────────────────────────────────────────────────
  def build_attrs(opts)
    return '' if opts.nil? || opts.empty?
    opts.map do |k, v|
      next if v.nil? || v == false
      key = k.to_s
      val = if k == :target && v == :blank then '_blank'
            elsif v.is_a?(Array) then v.compact.join(' ')
            else v.to_s
            end
      " #{key}=\"#{CGI.escapeHTML(val)}\""
    end.compact.join
  end

  def content_tag(tag, content_or_opts = nil, opts = {}, _escape = true, &block)
    if block_given?
      tag_opts = content_or_opts.is_a?(Hash) ? content_or_opts : opts
      saved = @_erbout; @_erbout = ''
      block.call
      inner = @_erbout; @_erbout = saved
      result = "<#{tag}#{build_attrs(tag_opts)}>#{inner}</#{tag}>"
      @_erbout << result  # concat for <% content_tag do %> style (preprocessed from <%=)
      result
    else
      if content_or_opts.is_a?(Hash)
        tag_opts = content_or_opts; content = nil
      else
        content  = content_or_opts; tag_opts = opts
      end
      "<#{tag}#{build_attrs(tag_opts)}>#{content}</#{tag}>"
    end
  end

  def link_to(name_or_url, url_or_opts = nil, opts = {}, &block)
    if block_given?
      href      = name_or_url
      link_opts = url_or_opts.is_a?(Hash) ? url_or_opts : {}
      saved = @_erbout; @_erbout = ''
      block.call
      inner = @_erbout; @_erbout = saved
      result = "<a#{build_attrs({ href: href }.merge(link_opts))}>#{inner}</a>"
      @_erbout << result  # concat for <% link_to do %> style (preprocessed from <%=)
      result
    elsif url_or_opts.nil? || url_or_opts.is_a?(Hash)
      href = name_or_url.to_s
      "<a href=\"#{CGI.escapeHTML(href)}\">#{name_or_url}</a>"
    else
      href = url_or_opts.to_s
      "<a#{build_attrs({ href: href }.merge(opts))}>#{name_or_url}</a>"
    end
  end

  def image_tag(src, opts = {})
    s   = src.to_s
    url = (s.start_with?('http', '//', '/') ? s : "#{BASE}/images/#{s}")
    "<img src=\"#{url}\"#{build_attrs(opts)}>"
  end

  def image_url(src); (src.to_s.start_with?('/') ? src : "#{BASE}/images/#{src}"); end
  def image_path(src); image_url(src); end

  # ── Site-specific helpers ─────────────────────────────────────────────────
  def subheader(title, tail = nil)
    tail_html = tail ? "<div class=\"tail\"><a href=\"#{tail[:url]}\">#{tail[:text]}</a></div>" : ''
    "<div class=\"subheader\">#{title}<div class=\"bullet\"></div>#{tail_html}</div>"
  end

  def subtitle(title)
    "<div class=\"content_subtitle\">#{title}</div>"
  end

  def end_back_link(text, url)
    "<div class=\"end_back_link\"><a href=\"#{url}\">&larr; #{text}</a></div>"
  end

  def submission_system_button
    '' # Submission closed — conference was April 2017
  end

  # Programs-page helpers
  def session(index, rowspan = 1)
    name = Array(@session_ordered_names)[index]
    "<td class='session' rowspan='#{rowspan}'><a href='#session_#{index}'>" \
    "<div class='session'>Papers &amp; Notes</div>" \
    "<div class='session_title'>#{name}</div></a></td>"
  end

  def cell_coffee(colspan = 1)
    "<td class='coffee' colspan='#{colspan}'>Coffee break</td>"
  end

  # ── Route helpers ─────────────────────────────────────────────────────────
  def root_path;              "#{BASE}/";                        end
  def programs_path(o = {});  "#{BASE}/programs#{_anchor(o)}";   end
  def awards_path;            "#{BASE}/awards";                  end
  def cfp_path;               "#{BASE}/cfp";                     end
  def cfp_paper_path;         "#{BASE}/cfp/paper";               end
  def cfp_note_path;          "#{BASE}/cfp/visualization_notes"; end
  def cfp_poster_path;        "#{BASE}/cfp/posters";             end
  def cfp_contest_path;       "#{BASE}/cfp/contest";             end
  def committee_path;         "#{BASE}/committee";               end
  def venue_path(o = {});     "#{BASE}/venue#{_anchor(o)}";      end
  def registration_path;      "#{BASE}/registration";            end
  def keynote_path(id);       "#{BASE}/keynotes/#{id}";          end
  def workshop_path(id);      "#{BASE}/workshops/#{id}";         end
  def program_path(id);       "#{BASE}/programs/#{id}";          end
  def program_download_path(name); "#{BASE}/files/pdf/#{name}.pdf"; end

  private

  def _anchor(opts)
    opts[:anchor] ? "##{opts[:anchor]}" : ''
  end
end

# ── Layout wrapper ─────────────────────────────────────────────────────────────
def make_page(title:, content:, banner_image: 'dongdaemun.jpg', banner_size: :short)
  banner_class = banner_size == :tall ? 'tall' : 'short'
  img_src      = "#{BASE}/images/#{banner_image}"
  plain_title  = title.to_s.gsub(/<[^>]*>/, '').strip

  sidebar_ctx  = Context.new
  sidebar      = sidebar_ctx.render(partial: 'application/left_common_content')

  title_h2 = title ? "<h2>#{title}</h2>" : ''
  venue_strip = banner_size == :tall ?
    '<span class="text_strip small">Hoam Faculty House @ Seoul National University</span>' : ''

  <<~HTML
    <!DOCTYPE html>
    <html lang="en">
    <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <title>IEEE PacificVis 2017#{plain_title.empty? ? '' : " \u2013 #{plain_title}"}</title>
      <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet">
      <link rel="stylesheet" href="#{BASE}/assets/styles.css">
      <link rel="stylesheet" href="#{BASE}/assets/programs.css">
    </head>
    <body>
      <div id="wrap">
        <div id="header">
          <div class="strip"></div>
          <div id="title">
            <a href="#{BASE}/"><img src="#{BASE}/images/pacific_vis_logo.svg" alt="IEEE PacificVis 2017"></a>
          </div>
          <ul id="gnb">
            <li><a href="#{BASE}/">Home</a></li>
            <li><a href="#{BASE}/programs">Programs</a></li>
            <li><a href="#{BASE}/awards">Awards</a></li>
            <li><a href="#{BASE}/cfp">Calls</a></li>
            <li><a href="#{BASE}/committee">Organizers</a></li>
            <li><a href="#{BASE}/venue">Travel+Venue</a></li>
          </ul>
        </div>
        <div id="main">
          <div id="main_image" class="#{banner_class}">
            <img src="#{img_src}" alt="PacificVis 2017 Seoul">
            <div id="text_strips" class="#{banner_class}">
              <span class="text_strip big">SEOUL | KOREA</span><br>
              <span class="text_strip big">APRIL 18-21, 2017</span><br>
              #{venue_strip}
            </div>
          </div>
          <table id="home_main_wrapper">
            <tr>
              <td id="home_left">#{sidebar}</td>
              <td id="home_main">
                #{title_h2}
                #{content}
              </td>
            </tr>
          </table>
        </div>
        <div id="footer">
          <div id="copyright">Copyright &copy; 2016 IEEE PacificVis. All Rights Reserved.</div>
        </div>
      </div>
    </body>
    </html>
  HTML
end

# ── Rendering helpers ──────────────────────────────────────────────────────────
def render_view(view_dir, template_name, vars = {})
  ctx = Context.new(vars)
  ctx._view_dir = view_dir
  file = File.join(VIEWS, view_dir, "#{template_name}.html.erb")
  ctx._erbout = ''
  ctx._render_template(file)
  ctx._erbout
end

def save_page(out_rel, html)
  path = File.join(OUTPUT, out_rel)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, html, encoding: 'UTF-8')
  puts "  #{out_rel}"
end

def build_page(out_rel, view_dir:, template:, title:, vars: {},
               banner_image: 'dongdaemun.jpg', banner_size: :short)
  content = render_view(view_dir, template, vars)
  html    = make_page(title: title, content: content,
                      banner_image: banner_image, banner_size: banner_size)
  save_page(out_rel, html)
rescue => e
  warn "  ERROR rendering #{out_rel}: #{e.message}"
  warn "    #{e.backtrace.first(3).join("\n    ")}"
end

