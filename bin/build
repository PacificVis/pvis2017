#!/usr/bin/env ruby
# bin/build  –  Generate GitHub Pages static site for PacificVis 2017
# Usage:  ruby bin/build [BASE_URL]
#   BASE_URL defaults to /pvis2017 (GitHub Pages project path)
#   Set BASE_URL='' to build for serving at root.

require 'erb'
require 'yaml'
require 'csv'
require 'sqlite3'
require 'fileutils'
require 'date'
require 'cgi'

ROOT   = File.expand_path('..', __dir__)
OUTPUT = File.join(ROOT, 'docs')
DATA   = File.join(ROOT, 'app/data')
VIEWS  = File.join(ROOT, 'app/views')
ASSETS = File.join(ROOT, 'app/assets')
PUBLIC = File.join(ROOT, 'public')
BASE   = ENV.fetch('BASE_URL', '/pvis2017')

SASS_BIN = [
  File.join(ROOT, 'vendor/bundle/ruby/2.4.0/gems/sass-3.4.22/bin/sass'),
  File.join(ROOT, 'vendor/bundle/ruby/3.0.0/gems/sass-3.4.22/bin/sass'),
  `which sass 2>/dev/null`.strip
].find { |p| !p.empty? && File.exist?(p) }

# ── String / Array extensions ─────────────────────────────────────────────────
class String
  def html_safe; self; end
end

class Array
  def to_sentence
    case size
    when 0 then ''
    when 1 then first.to_s
    when 2 then "#{first} and #{last}"
    else "#{self[0..-2].join(', ')}, and #{last}"
    end
  end
end

# ── Structs for DB objects ────────────────────────────────────────────────────
ChairThumb = Struct.new(:url_str) do
  def exists?; !url_str.nil?; end
  def url(_style = :original); url_str; end
end

Chair = Struct.new(:id, :name, :affiliation, :thumb_url) do
  def thumbnail; ChairThumb.new(thumb_url); end
end

ChairGroup = Struct.new(:id, :name, :email, :chairs)
PreviousConf = Struct.new(:year, :location, :url, :from, :to)

# ── File helpers ──────────────────────────────────────────────────────────────
def find_thumb(type, id, style = nil)
  dir = File.join(PUBLIC, 'files', type, 'thumbnails')
  return nil unless File.directory?(dir)
  # Prefer the style-specific file (e.g. "1_thumb_xxx.png"), exclude retina/original
  pattern = style ? "#{id}_#{style}_*" : "#{id}_*"
  files = Dir.glob(File.join(dir, pattern))
              .reject { |f| f =~ /_(original|retina)_/ }
  files = Dir.glob(File.join(dir, pattern)) if files.empty?
  return nil if files.empty?
  f = files.max_by { |x| File.mtime(x) }
  "#{BASE}/files/#{type}/thumbnails/#{File.basename(f)}"
end

def load_csv_file(filename)
  raw = File.read(File.join(DATA, filename), encoding: 'UTF-8')
  raw.gsub!(/\A\xEF\xBB\xBF/, '')  # strip BOM
  CSV.parse(raw, headers: true, liberal_parsing: true)
end

def load_program(venue)
  load_csv_file("program_list_#{venue}.csv").map do |row|
    id = row[0]&.strip
    next if id.nil? || id.empty?
    type = case id
           when /\Apapers/ then 'Paper'
           when /\Anotes/  then 'Note'
           when /\Aposters/ then 'Poster'
           when /\Acontest/ then 'Contest'
           else 'Unclassified'
           end
    authors = (1..10).map do |i|
      given  = row["Given name #{i}"]&.strip
      family = row["Family name #{i}"]&.strip
      next if given.nil? || given.empty?
      { name: "#{given} #{family}".strip,
        email: row["Email address #{i}"],
        affiliation: row["Primary Affiliation #{i} - Institution"] }
    end.compact
    { id: id, title: row['title'], type: type,
      abstract: row['abstract'], authors: authors }
  end.compact
end

def load_contest
  load_csv_file('program_list_contests.csv').map do |row|
    id = row[0]&.strip
    next if id.nil? || id.empty?
    authors = (row['authors'] || '').split(',').map { |a| { name: a.strip } }
    { id: id, title: row['title'], type: 'Contest',
      abstract: row['abstract'], authors: authors,
      video: row['video'], link: row['link'],
      pdf: row['pdf'], image: row['image'] }
  end.compact
end

def load_committee(filename)
  load_csv_file(filename).map do |row|
    fn = row['first_name']&.strip
    ln = row['last_name']&.strip
    next if fn.nil? && ln.nil?
    { name: "#{fn} #{ln}".strip, affiliation: row['affiliation'] }
  end.compact
end

def get_deadlines(key)
  (DATES[key] || {}).to_a.map { |name, time| { name: name, time: time.to_s } }
end

# ── Load SQLite data ──────────────────────────────────────────────────────────
db = SQLite3::Database.new(File.join(ROOT, 'db/development.sqlite3'))
db.results_as_hash = true

chairs_by_id = {}
db.execute('SELECT id, name, affiliation FROM chairs ORDER BY id') do |r|
  chairs_by_id[r['id']] = Chair.new(r['id'], r['name'], r['affiliation'],
                                     find_thumb('chairs', r['id'], 'thumb'))
end

CHAIR_GROUPS = []
db.execute('SELECT id, name, email FROM chair_groups ORDER BY position, id') do |r|
  members = []
  db.execute(
    'SELECT chair_id FROM chair_assignments WHERE chair_group_id=? ORDER BY COALESCE(position,999), id',
    [r['id']]
  ) { |a| members << chairs_by_id[a['chair_id']] }
  CHAIR_GROUPS << ChairGroup.new(r['id'], r['name'], r['email'].to_s, members.compact)
end

SPONSORS = []
db.execute('SELECT id, name, url FROM sponsors ORDER BY COALESCE(position,999), id') do |r|
  SPONSORS << { name: r['name'], url: r['url'].to_s,
                thumbnail: find_thumb('sponsors', r['id']) }
end

PREVIOUS = []
db.execute('SELECT year, location, url, "from", "to" FROM previous_conferences ORDER BY year DESC') do |r|
  PREVIOUS << PreviousConf.new(r['year'], r['location'], r['url'],
                                Date.parse(r['from']), Date.parse(r['to']))
end

